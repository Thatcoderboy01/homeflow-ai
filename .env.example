# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# --- Database (MySQL 8+ / MariaDB 10.11+) ---
DATABASE_URL=mysql://homeflow:homeflow@127.0.0.1:3306/homeflow
# Used only by `npm test`. The test run DROPS and recreates this database.
TEST_DATABASE_URL=mysql://homeflow:homeflow@127.0.0.1:3306/homeflow_test

# --- API ---
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# How long a proposed plan can be approved (seconds)
APPROVAL_TTL_SECONDS=900

# --- MCP server (Streamable HTTP) ---
MCP_HOST=127.0.0.1
MCP_PORT=4100
MCP_URL=http://127.0.0.1:4100/mcp
# Browser origins allowed to call /mcp (leave empty: only the API calls it)
MCP_ALLOWED_ORIGINS=
# Shared secret between API (MCP client) and MCP server. Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# --- AI provider: Gemini (required for the application runtime) ---
AI_PROVIDER=gemini
# Keep this server-side; never expose it to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional secondary TTS provider, used only when Gemini TTS is exhausted/unavailable.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
AI_TIMEOUT_MS=30000

# --- Web (Vite) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
