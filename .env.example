# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# --- Database (MySQL 8+ / MariaDB 10.11+) ---
DATABASE_URL=mysql://homeflow:homeflow@127.0.0.1:3306/homeflow
# Used only by `npm test`. The test run DROPS and recreates this database.
TEST_DATABASE_URL=mysql://homeflow:homeflow@127.0.0.1:3306/homeflow_test

# --- API ---
API_HOST=127.0.0.1
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# How long a proposed plan can be approved (seconds)
APPROVAL_TTL_SECONDS=900

# --- MCP server (Streamable HTTP) ---
MCP_HOST=127.0.0.1
MCP_PORT=4100
MCP_URL=http://127.0.0.1:4100/mcp
# Browser origins allowed to call /mcp (leave empty: only the API calls it)
MCP_ALLOWED_ORIGINS=
# Shared secret between API (MCP client) and MCP server. Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# --- AI provider: "mock" (default, no credentials) or "bedrock" ---
AI_PROVIDER=mock
# Only for AI_PROVIDER=bedrock. Credentials come from the standard AWS chain
# (env vars, ~/.aws/credentials, SSO, instance role). Never put them in the browser/.env committed to git.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
AI_TIMEOUT_MS=30000

# --- Web (Vite) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
