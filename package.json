{
  "name": "homeflow-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HomeFlow AI - Your Family's Action Agent (hackathon starter, local demo build)",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,mcp,web -c cyan,magenta,green \"npm run dev -w @homeflow/api\" \"npm run dev -w @homeflow/mcp-server\" \"npm run dev -w @homeflow/web\"",
    "build": "npm run build -w @homeflow/api -w @homeflow/mcp-server -w @homeflow/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "npm run generate -w @homeflow/database",
    "db:migrate": "npm run migrate -w @homeflow/database",
    "db:migrate:deploy": "npm run migrate:deploy -w @homeflow/database",
    "db:seed": "npm run seed -w @homeflow/database",
    "db:reset": "npm run reset -w @homeflow/database",
    "postinstall": "npm run generate -w @homeflow/database"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "dotenv": "^18.0.7",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "mariadb": "^3.5.4",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
